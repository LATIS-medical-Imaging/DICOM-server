# pgAdmin (web database UI — http://localhost:5050)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Application
APP_NAME=
APP_ENV=            # development | staging | production
APP_DEBUG=
APP_HOST=
APP_PORT=
APP_LOG_LEVEL=           # DEBUG | INFO | WARNING | ERROR

CORS_ORIGINS=

# Security / JWT
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_REFRESH_TOKEN_EXPIRE_DAYS=

# Argon2 password hashing parameters
ARGON2_TIME_COST=
ARGON2_MEMORY_COST=
ARGON2_PARALLELISM=

# PostgreSQL (direct connection parameters)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=         # use "postgres" to bypass pooler
POSTGRES_PORT=              # 6432 = pgbouncer, 5432 = postgres direct

# SQLAlchemy pool tuning (per API worker)
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=
MINIO_EXTERNAL_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=
MINIO_BUCKET_DICOM=
MINIO_BUCKET_THUMBNAILS=
MINIO_BUCKET_AUDIO=
MINIO_PRESIGNED_URL_EXPIRE_SECONDS=
# Voice messages. The size cap is checked against the object MinIO stored,
# not against anything the client claimed.
VOICE_MESSAGE_MAX_BYTES=
VOICE_MESSAGE_MAX_DURATION_MS=
# Override per environment — staging/prod should set the real domain.
CORS_MINIO_ORIGIN=

# Deep segmentation (medical-image-std DeepSegmentationAlgorithm)
DEEP_SEGMENTATION_MODEL_SERVER_URL=
DEEP_SEGMENTATION_MODEL_CACHE_DIR=
# auto | cpu | cuda  (auto = cuda when the container really has one)
DEEP_SEGMENTATION_DEVICE=auto
# Cap torch's CPU thread pool to the container's vCPU quota. 0 = torch default.
TORCH_NUM_THREADS=0

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_DEFAULT_QUEUE=

# Uploads
MAX_UPLOAD_SIZE_MB=

# R2 CloudFlare
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ACCOUNT_ID=

# Admin bootstrap (only used by `python -m app.cli.seed_admin`)
# Run once after `alembic upgrade head` to create the first administrator.
# Idempotent: re-running is a no-op if the email already exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=

# Comma-separated checkpoints loaded at startup so the first request doesn't
# pay the download + torch.load. Empty disables preloading.
DEEP_SEGMENTATION_PRELOAD_MODELS=
# Queue for filter/segmentation tasks, served by the pixel-worker service.
CELERY_PIXEL_QUEUE=pixels
# API process count. Each carries its own torch runtime (~1-1.5 GB).
UVICORN_WORKERS=2
